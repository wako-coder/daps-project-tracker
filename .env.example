APP_NAME="Project Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL everywhere: local, CI and production.
# Local database: docker compose up -d   (see docker-compose.yml)
# In production set DB_URL instead (the full connection string from the host).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5544
DB_DATABASE=tracker
DB_USERNAME=tracker
DB_PASSWORD=tracker
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Invitation emails, sent through Brevo's HTTPS API (https://www.brevo.com).
# Optional: with BREVO_API_KEY empty, invitations are off and admins can only
# add people who already have an account.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Project Tracker"

# Passwords for the two demo accounts created by `php artisan db:seed`.
# Choose your own; never commit real values.
DEMO_ADMIN_PASSWORD=
DEMO_MEMBER_PASSWORD=
